# ============================================================
#  Custos TI — variáveis de ambiente do backend seguro
#  Copie para ".env" e preencha. NUNCA commite o .env real.
#  (o .gitignore já ignora .env)
# ============================================================

# ---- DigitalOcean ----
# Crie em: API > Tokens > Generate New Token  (marque APENAS "Read")
DO_TOKEN=dop_v1_coloque_seu_token_read_aqui

# ---- AWS (Cost Explorer) ----
# Crie um usuário IAM com política mínima contendo somente:
#   { "Effect":"Allow", "Action":["ce:GetCostAndUsage"], "Resource":"*" }
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ---- DeepSeek ----
# A API do DeepSeek NÃO expõe billing. Informe o valor do mês (USD) à mão:
DEEPSEEK_USD_MANUAL=0

# ---- Rede / segurança ----
# Origem exata do dashboard (para travar o CORS). Em dev pode usar *
ALLOWED_ORIGIN=https://custos.seudominio.com.br
PORT=8787
