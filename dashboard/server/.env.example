# ============================================================
#  Custos TI — variáveis de ambiente do backend seguro
#  Copie para ".env" e preencha. NUNCA commite o .env real.
#  (o .gitignore já ignora .env)
# ============================================================

# ---------- DigitalOcean ----------
# API > Tokens > Generate New Token  (marque APENAS o escopo "Read")
DO_TOKEN=dop_v1_coloque_seu_token_read_aqui

# ---------- AWS (Cost Explorer) ----------
# Usuário IAM com política MÍNIMA contendo somente:
#   { "Effect":"Allow", "Action":["ce:GetCostAndUsage"], "Resource":"*" }
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ---------- DeepSeek ----------
# A API do DeepSeek expõe apenas SALDO (não o custo por período).
# 1) DEEPSEEK_API_KEY  -> mostra o SALDO ao vivo no painel (como o "Topped-up balance" da tela)
# 2) DEEPSEEK_USD_MANUAL -> o "Total cost" que você lê no console (ex.: 0.76), por período
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_USD_MANUAL=0.76

# ---------- Licenças (valores fixos mensais em BRL) ----------
CLAUDE_PRO_USERS=19
CLAUDE_PRO_UNIT_BRL=110
FIGMA_LICENSES=1
FIGMA_UNIT_BRL=120

# ---------- Rede / segurança ----------
# Origem exata do dashboard (para travar o CORS). Em dev pode usar *
ALLOWED_ORIGIN=https://custos.seudominio.com.br
PORT=8787
