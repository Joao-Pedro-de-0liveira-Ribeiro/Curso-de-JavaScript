# ============================================================
#  Custos TI — variáveis de ambiente do backend seguro
#  Copie para ".env" e preencha. NUNCA commite o .env real.
#  (o .gitignore já ignora .env)
# ============================================================

# ---------- DigitalOcean ----------
# API > Tokens > Generate New Token  (escopo "Read" — inclui billing/faturas).
# O painel usa as FATURAS mensais reais (/v2/customers/my/invoices): o total do
# período bate com a conta e muda conforme a data (Julho=fatura de Julho, etc.).
DO_TOKEN=dop_v1_coloque_seu_token_read_aqui

# ---------- AWS ----------
# Cost Explorer roda sempre em us-east-1 (o código já força isso).
# AWS_REGION é a região dos SEUS recursos (para o detector de desperdício
# consultar ECS/EBS/EIP) — normalmente sa-east-1.
# Política (tudo leitura, sem admin): ce:GetCostAndUsage (custos) +
#   cloudwatch:GetMetricStatistics, rds:DescribeDBInstances,
#   elasticloadbalancing:DescribeLoadBalancers, ecs:List*/Describe*,
#   ec2:DescribeVolumes, ec2:DescribeAddresses  (detector de ociosos por uso).
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=sa-east-1

# ---------- DeepSeek ----------
# A API do DeepSeek expõe apenas SALDO. O gasto é CALCULADO:
#   gasto = DEEPSEEK_TOTAL_TOPPED_UP − saldo topped-up atual (via /user/balance)
DEEPSEEK_API_KEY=sk-...
# total já depositado na conta DeepSeek (ex.: 2.00). O backend calcula o gasto.
DEEPSEEK_TOTAL_TOPPED_UP=2.00

# ---------- Licenças ----------
# O valor de cada licença é buscado dos PREÇOS OFICIAIS (USD) e convertido
# pelo dólar ao vivo. Deixe em branco para usar os oficiais:
#   Claude Pro US$20 · Claude Max US$100 (5x; 20x = 200) · Figma ~US$16
# Sobrescreva só se o seu preço for diferente:
#CLAUDE_PRO_USD=20
#CLAUDE_MAX_USD=100
#FIGMA_USD=16
# …ou fixe direto em reais (tem prioridade sobre o USD):
#CLAUDE_PRO_BRL=110
#FIGMA_BRL=120

# ---------- Rede / segurança ----------
# Origem exata do dashboard (para travar o CORS). Em dev pode usar *
ALLOWED_ORIGIN=https://custos.seudominio.com.br
PORT=8787
